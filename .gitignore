# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Node
node_modules/

# App runtime artifacts
server.log
*.log
gui_1_camera_calibration/work/
session_config.json
scene_placements.json
eye_positions_*.json
gui_4_scene_placement/exports/
gui_4_scene_placement/eye_positions/

# Generated data — keep the folder structure (.gitkeep), not the contents.
# Ignoring "dir/**" would also ignore dir's subfolders themselves, which
# blocks a later "!.../.gitkeep" negation from reaching into them — so
# these ignore one level of *contents* at a time instead.
data/raw_videos/*/*
!data/raw_videos/*/.gitkeep
data/calibration/checkerboard_frames/*
!data/calibration/checkerboard_frames/.gitkeep
data/calibration/output/*
!data/calibration/output/.gitkeep
data/masks/*/*
!data/masks/*/.gitkeep
data/meshes/rat/*
!data/meshes/rat/.gitkeep
data/meshes/environment/*
!data/meshes/environment/.gitkeep
data/eye_positions/*
!data/eye_positions/.gitkeep
data/scenes/*
!data/scenes/.gitkeep

# GUI-local output dirs (mirrors of data/, kept for local runs)
gui_1_camera_calibration/output/*
gui_2_rat_reconstruction/output/*
!gui_1_camera_calibration/output/.gitkeep
!gui_2_rat_reconstruction/output/.gitkeep

# GUI 5.x runtime artefacts
gui_5.*/exports/
gui_5.*/cache/

# Large or third-party assets (see README: not redistributed)
gui_5.1_quaternion_placement/assets/*.stl
gui_2_rat_reconstruction/templates/rat_brown.obj

# video_rendering/ working folders (inputs, intermediate fits, frames, logs)
video_rendering/inputs/
video_rendering/data/
video_rendering/frames*/
video_rendering/refit*/
video_rendering/variants/
video_rendering/logs/
video_rendering/qa/
video_rendering/*.mp4

# beast3d_export/ outputs
beast3d_export/calib_check/

# macOS resource forks from network drives
._*
